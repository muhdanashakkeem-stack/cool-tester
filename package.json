{
  "name": "cool-tester",
  "version": "0.2.0",
  "description": "Offline security tester for vibe coders. Reads your code, attacks your local app, and tells your AI agent how to fix it. No API key.",
  "type": "module",
  "bin": { "cool-tester": "bin/cool-tester.js" },
  "files": ["bin", "src", "rules", "README.md"],
  "scripts": {
    "test": "node --test test/scan.test.js test/attack.test.js test/mcp.test.js test/locks.test.js",
    "audit": "node bin/cool-tester.js audit"
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  }
}
